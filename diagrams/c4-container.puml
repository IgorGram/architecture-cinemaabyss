
@startuml C4_Container_Diagram
title CinemaAbyss - Containers

top to bottom direction

!define DEVICONS https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/master/devicons
!include <C4/C4_Container>
!include DEVICONS/postgresql.puml

Person(user, "", $descr="User", $tags="", $link="")
Person(admin, "", $descr="Admin", $tags="", $link="")

Container(mobileApplication, "Mobile Application", $techn="Android IOS", $descr="Мобильное приложение", $tags="", $link="")
Container(webApplication, "Web Application", $techn="JS, Angular, React, Node.js", $descr="WEB приложение", $tags="", $link="")
Container(smartTv, "Smart TV", $techn="Android", $descr="Приложение для smart TV", $tags="", $link="")
Container(adminWebApplication, "Admin Web Application", $techn="JS, Angular, React, Node.js", $descr="WEB приложение для амина", $tags="", $link="")

System_Boundary("CinemaAbyss_boundary", "Cinema Abyss System", $tags="") {
    Container(CinemaAbyss.ApiGateWay, "API gateway", $techn="Spring Cloud", $descr="Единая точка входа для приложения", $tags="", $link="", $sprite="")

    Container(CinemaAbyss.UserService, "User service", $techn="Spring boot", $descr="Сервис пользователей", $tags="", $link="")
    ContainerDb(CinemaAbyss.UserService.Database, "", $techn="Postgres", $descr="", $tags="", $link="", $sprite="postgresql")

    Container(CinemaAbyss.DeviceService, "Device service", $techn="Spring boot", $descr="Сервис устройств", $tags="", $link="", $sprite="java")
    ContainerDb(CinemaAbyss.DeviceService.Database, "", $techn="Postgres", $descr="", $tags="", $link="", $sprite="postgresql")

    Container(CinemaAbyss.MoviesService, "Movies service", $techn="Spring boot", $descr="Сервис хранения метаданных фильмов", $tags="", $link="", $sprite="java")
    ContainerDb(CinemaAbyss.MoviesService.Database, "", $techn="Postgres", $descr="", $tags="", $link="", $sprite="postgresql")

    Container(CinemaAbyss.RatingAndFavoriteService, "Rating and Favorite service", $techn="Spring boot", $descr="Сервис хранения избранных фильмов и оценок", $tags="", $link="", $sprite="java")
    ContainerDb(CinemaAbyss.RatingAndFavoriteService.Database, "", $techn="Postgres", $descr="", $tags="", $link="", $sprite="postgresql")

     Container(CinemaAbyss.HistoryService, "History service", $techn="Spring boot", $descr="Сервис истории просмотров", $tags="", $link="", $sprite="java")
     ContainerDb(CinemaAbyss.History.Database, "", $techn="Postgres", $descr="", $tags="", $link="", $sprite="postgresql")

    Container(CinemaAbyss.SubscriptionService, "Subscription service", $techn="Spring boot", $descr="Сервис подписок", $tags="", $link="", $sprite="java")
    ContainerDb(CinemaAbyss.SubscriptionService.Database, "", $techn="Postgres", $descr="", $tags="", $link="", $sprite="postgresql")

    Container(CinemaAbyss.PaymentService, "Payment service", $techn="Spring boot", $descr="Сервис платежей", $tags="", $link="", $sprite="java")
    ContainerDb(CinemaAbyss.PaymentService.Database, "", $techn="Postgres", $descr="", $tags="", $link="", $sprite="postgresql")

    Container(CinemaAbyss.NotificationService, "Notification service", $techn="Spring boot", $descr="Сервис уведомлений", $tags="", $link="", $sprite="java")
    ContainerDb(CinemaAbyss.NotificationService.Database, "", $techn="Postgres", $descr="", $tags="", $link="", $sprite="postgresql")

    Container(CinemaAbyss.AdminService, "Admin service", $techn="Spring boot", $descr="Сервис администрирования", $tags="", $link="", $sprite="java")
    ContainerDb(CinemaAbyss.AdminService.Database, "", $techn="Postgres", $descr="", $tags="", $link="", $sprite="postgresql")

    Container(CinemaAbyss.RecommendationInterfaceService, "Recommendation interface service", $techn="Spring boot", $descr="Сервис уведомлений", $tags="", $link="", $sprite="java")

}

SystemQueue_Ext(Broker, "Kafka", $descr="Брокер сообщений", $tags="", $link="")

System_Ext(SmsNotificationSystem, "SMS notification system", $descr="Сервис рассылки СМС сообщений", $tags="", $link="")
System_Ext(PushNotificationSystem, "PUSH notification system", $descr="Сервисы рассылки PUSH-уведомлений (FireBase, AppleSDK)", $tags="", $link="")
System_Ext(EmailNotificationSystem, "E-mail system", $descr="Сервис рассылки E-mail", $tags="", $link="")
System_Ext(RecommendationSystem, "Recommendation system", $descr="Рекомендательная система", $tags="", $link="")

